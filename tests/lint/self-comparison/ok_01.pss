// expect: none
// The intended comparisons: `this` reaches the enclosing action's field.
component pss_top {
  action write_a { rand bit[32] size; }
  action test {
    rand bit[32] size;
    rand bit[8] arr[4];
    rand bit[2] i;
    rand bit[2] j;
    constraint arr[i] != arr[j];
    activity {
      do write_a with { size == this.size; }
    }
  }
}
