
package sync_pkg {
    import std_pkg::*;

    component channel_c<type T, int DEPTH=1> {
        // 21.9.1 -- the target-time API. All four are target functions:
        // callable from body/run_start/run_end and functions reached from
        // them, never from a solve exec.
        target function T      get();
        target function void   put(T t);
        target function bool   try_get(output T t);
        target function bool   try_put(T t);
    }

}
