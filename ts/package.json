{
  "name": "@psstools/pssparser",
  "version": "0.1.0",
  "description": "PSS (Portable Test and Stimulus Standard) parser -- the pssparser C++ core compiled to WebAssembly, with a TypeScript API",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psstools/pssparser.git",
    "directory": "ts"
  },
  "homepage": "https://github.com/psstools/pssparser#readme",
  "bugs": {
    "url": "https://github.com/psstools/pssparser/issues"
  },
  "keywords": [
    "pss",
    "portable stimulus",
    "accellera",
    "parser",
    "webassembly"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ast": {
      "types": "./dist/ast/generated/index.d.ts",
      "default": "./dist/ast/generated/index.js"
    }
  },
  "files": [
    "dist",
    "scripts/prepare.mjs",
    "scripts/ivpm-python.mjs"
  ],
  "scripts": {
    "gen:ast": "node scripts/astbuilder.mjs gen-ts -astdir ../ast -o src/ast/generated",
    "gen:ast-parity-fixture": "cd .. && PYTHONPATH=python packages/python/bin/python ts/scripts/gen-ast-parity-fixture.py -o ts/test/fixtures/ast-parity.json",
    "gen:census": "node scripts/astbuilder.mjs gen-census -astdir ../ast -py scripts/generated -ts test/generated",
    "gen:census-parity-fixture": "cd .. && PYTHONPATH=python packages/python/bin/python ts/scripts/gen-census-parity-fixture.py -o ts/test/fixtures/census-parity.json",
    "gen:link-parity-fixture": "cd .. && PYTHONPATH=python packages/python/bin/python ts/scripts/gen-link-parity-fixture.py -o ts/test/fixtures/link-parity.json",
    "gen:parity-fixture": "cd .. && PYTHONPATH=python packages/python/bin/python ts/scripts/gen-parity-fixture.py -o ts/test/fixtures/parity.json",
    "gen:wasm": "node scripts/build-wasm.mjs",
    "generate": "npm run gen:ast && npm run gen:census && npm run gen:wasm",
    "prepare": "node scripts/prepare.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-wasm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
