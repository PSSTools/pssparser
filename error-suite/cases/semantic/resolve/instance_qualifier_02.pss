//! case:            SEM-RESOLVE-INSTANCE-QUALIFIER-02
//! class:           semantic.resolve
//! title:           a component instance used as the qualifier of an activity handle type
//! expect:          error
//! detect:          required
//! lrm:             18.3, 9.1.3
//! pssparser.id:    PSS002
//! pssparser.match: 'tx' is a component instance, not a type or package
//! at:              25:13
//! count:           1
//! fix:             25:            tx_c::send_a s;
//! cause:           instance, type
//! names:           tx
//! tags:            resolve, qualifier, activity
buffer b_s { rand bit[8] v; }
component tx_c { action send_a { output b_s o; } }
component rx_c { action recv_a { input b_s i; } }
component pss_top {
    tx_c tx;
    rx_c rx;
    pool b_s p;
    bind p *;
    action A {
        activity {
            tx::send_a s;
            tx_c::send_a s2;
            rx_c::recv_a r;
            bind s2.o r.i;
        }
    }
}
