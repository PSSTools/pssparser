//! case:            SEM-COMPILE-COMPILE-IF-UNBRACED-ELSE
//! class:           semantic.compile
//! title:           compile if unbraced else
//! expect:          warning
//! detect:          recommended
//! lrm:             19.2
//! pss:             3.1
//! pssparser.id:    PSS104
//! at:              18:9-27
//! pssparser.match: without enclosing braces is deprecated
//! also:            17:5 "'compile if' begins here"
//! count:           2
//! fix:            18:        action A { int a;; }
//! cause:            braces, deprecated
const int X = 1;
component C {
    compile if (X == 1)
        action A { int a; }
    else
        action B { int b; }
}
