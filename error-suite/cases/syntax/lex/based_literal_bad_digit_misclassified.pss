//! case:            SYN-LEX-BASED-LITERAL-BAD-DIGIT-MISCLASSIFIED
//! class:           syntax.lex
//! title:           based literal bad digit misclassified
//! expect:          error
//! detect:          required
//! lrm:             B
//! pssparser.id:    PSS011
//! at:              16:29
//! pssparser.match: invalid digit 'G' in based literal
//! count:           1
//! cause:            digit
//! names:            x
component C {
    action A {
        rand bit[8] x;
        constraint { x == 'hGZ; }
    }
}
