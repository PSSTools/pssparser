//! case:            SYN-TEMPLATE-MUSTACHE-MALFORMED-EXPRESSION
//! class:           syntax.template
//! title:           mustache malformed expression
//! expect:          error
//! detect:          required
//! lrm:             B
//! pssparser.id:    PSS109
//! at:              15:32
//! pssparser.match: malformed mustache expression: unexpected '+'
//! count:           1
//! cause:            mustache
component C {
    action A {
        rand int a;
        exec body cpp = """v = {{ a + }}""";
    }
}
